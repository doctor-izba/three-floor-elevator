      "title": "01 / INITIAL STATE",
      "text": "PLC connected. Cabin at floor 1. Doors closed. Start is a deliberate operator action."
    },
    {
      "atSeconds": 15.009,
      "title": "02 / FIELD → PLC → HMI",
      "text": "Buttons and sensors enter TriLOGI. The ladder returns motor commands and door commands over MQTT."
    },
    {
      "atSeconds": 22,
      "title": "03 / NORMAL TRIP · FLOOR 1 → FLOOR 3",
      "text": "Press Call on floor 3. The request is stored; travel requires confirmed closed doors."
    },
    {
      "atSeconds": 28.285,
      "title": "03 / ARRIVAL AND DOOR DWELL",
      "text": "Motor off. Door fully open. The nominal dwell timer is 5 seconds, then the door closes."
    },
    {
      "atSeconds": 42.008,
      "title": "04 / RETURN TRIP · FLOOR 3 → FLOOR 1",
      "text": "A new Call selects the lower floor. MOTOR_DOWN is active; MOTOR_UP remains off."
    },
    {
      "atSeconds": 61.018,
      "title": "05 / DOOR JAM · FAULT INJECTION",
      "text": "Enable the simulated closing jam and call the current floor to demonstrate the door cycle."
    },
    {
      "atSeconds": 68.696,
      "title": "05 / CLOSING TIMEOUT",
      "text": "The door cannot reach its closed sensor. An 8-second native timer monitors closing."
    },
    {
      "atSeconds": 78.971,
      "title": "05 / FAULT LATCHED · DOOR REOPENED",
      "text": "JAM_FLT, alarm and buzzer are active. Travel is disabled. The door has reopened at the landing."
    },
    {
      "atSeconds": 88.132,
      "title": "06 / REMOVE THE CAUSE · RESET",
      "text": "Jam removed. Reset clears the corrected fault; it must not restart the elevator."
    },
    {
      "atSeconds": 98.01,
      "title": "06 / SEPARATE START",
      "text": "Start is pressed separately. The door closes before any further travel can be allowed."
    },
    {
      "atSeconds": 108.005,
      "title": "07 / EMERGENCY STOP",
      "text": "Press E-stop while stationary. Native ESTOP_FLT latches and RUN is disabled."
    },
    {
      "atSeconds": 118.007,
      "title": "07 / RELEASE → RESET → START",
      "text": "Releasing E-stop does not restart the controller. Reset and a separate Start are required."
    },
